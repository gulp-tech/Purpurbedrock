diff --git a/src/main/java/io/papermc/paper/logging/SysoutCatcher.java b/src/main/java/io/papermc/paper/logging/SysoutCatcher.java
index a8e813ca89b033f061e695288b3383bdcf128531..63ac37fe6a16ff537775f31f1d46df82f74d749a 100644
--- a/src/main/java/io/papermc/paper/logging/SysoutCatcher.java
+++ b/src/main/java/io/papermc/paper/logging/SysoutCatcher.java
@@ -80,6 +80,11 @@ public final class SysoutCatcher {
                         plugin.getPluginMeta().getDisplayName())
                 );
             } catch (final IllegalArgumentException | IllegalStateException e) {
+                // Purpurbedrock start - suppress benign JDK dynamic agent warnings (e.g. ByteBuddy) on STDERR
+                if (clazz.getName().startsWith("sun.instrument.") && line != null && line.startsWith("WARNING: ")) {
+                    return;
+                }
+                // Purpurbedrock end
                 // If anything happens, the calling class doesn't exist, there is no JavaPlugin that "owns" the calling class, etc
                 // Just print out normally, with some added information
                 Bukkit.getLogger().log(this.level, String.format("%s[%s] %s", this.prefix, clazz.getName(), line));
diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java
index 7b520d3955f271d1dc8b38c3c0fdf0acd3a521a5..63cd5dca7eead5d8de456b4d2d9b7da04b526095 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java
@@ -210,6 +210,7 @@ class PaperPluginInstanceManager {
             // Perhaps abort here, rather than continue going, but as it stands,
             // an abort is not possible the way it's currently written
             this.server.getPluginManager().callEvent(new PluginEnableEvent(plugin));
+            if ("PlaceholderAPI".equalsIgnoreCase(plugin.getName())) { org.purpurmc.purpur.bedrock.BedrockPlaceholderHook.tryRegisterWithPlaceholderApi(plugin); } // Purpurbedrock - built-in %purpurbedrock_*% expansion
         } catch (Throwable ex) {
             this.handlePluginException("Error occurred (in the plugin loader) while enabling "
                 + plugin.getPluginMeta().getDisplayName() + " (Is it up to date?)", ex, plugin);
diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 2571b73f9dbe7cb91560adbf06f0c5eb1dae8bdb..37b21517a5e082cd829d696eba0250df8646154f 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -2820,6 +2820,8 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     @Override
     public int getPing() {
         if (this.getHandle().connection == null) throw new UnsupportedOperationException("Too early to call this method at this stage");
+        int bedrockPing = org.purpurmc.purpur.bedrock.BedrockPlaceholderHook.getDirectBedrockPing(this.getUniqueId()); // Purpurbedrock - real RakNet/NetherNet RTT ping
+        if (bedrockPing > 0) return bedrockPing; // Purpurbedrock
         return this.getHandle().connection.latency();
     }
 
diff --git a/src/main/java/org/bukkit/craftbukkit/help/SimpleHelpMap.java b/src/main/java/org/bukkit/craftbukkit/help/SimpleHelpMap.java
index 70b45a7d41f4bafac3b9738129d74af30e36b2a8..b9cafdcf276fd97e81e30764b19e151340b43e14 100644
--- a/src/main/java/org/bukkit/craftbukkit/help/SimpleHelpMap.java
+++ b/src/main/java/org/bukkit/craftbukkit/help/SimpleHelpMap.java
@@ -131,15 +131,19 @@ public class SimpleHelpMap implements HelpMap {
 
             // Register a topic
             for (Class c : this.topicFactoryMap.keySet()) {
-                if (c.isAssignableFrom(command.getClass())) {
-                    HelpTopic t = this.topicFactoryMap.get(c).createTopic(command);
-                    if (t != null) this.addTopic(t);
-                    continue outer;
-                }
-                if (command instanceof PluginCommand && c.isAssignableFrom(((PluginCommand) command).getExecutor().getClass())) {
-                    HelpTopic t = this.topicFactoryMap.get(c).createTopic(command);
-                    if (t != null) this.addTopic(t);
-                    continue outer;
+                try {
+                    if (c.isAssignableFrom(command.getClass())) {
+                        HelpTopic t = this.topicFactoryMap.get(c).createTopic(command);
+                        if (t != null) this.addTopic(t);
+                        continue outer;
+                    }
+                    if (command instanceof PluginCommand && ((PluginCommand) command).getExecutor() != null && c.isAssignableFrom(((PluginCommand) command).getExecutor().getClass())) {
+                        HelpTopic t = this.topicFactoryMap.get(c).createTopic(command);
+                        if (t != null) this.addTopic(t);
+                        continue outer;
+                    }
+                } catch (Throwable ex) {
+                    this.server.getLogger().log(java.util.logging.Level.WARNING, "[Purpurbedrock] Пропущена неисправная HelpTopicFactory для команды '" + command.getName() + "': " + ex.getMessage());
                 }
             }
             this.addTopic(new GenericCommandHelpTopic(command));
diff --git a/src/main/java/org/bukkit/craftbukkit/util/CraftMagicNumbers.java b/src/main/java/org/bukkit/craftbukkit/util/CraftMagicNumbers.java
index 80317dc41f85b91d7219f370d6f51e79496b09c4..d6a526cc71c25dffd2d9dc761072f4668f1611d1 100644
--- a/src/main/java/org/bukkit/craftbukkit/util/CraftMagicNumbers.java
+++ b/src/main/java/org/bukkit/craftbukkit/util/CraftMagicNumbers.java
@@ -390,8 +390,14 @@ public final class CraftMagicNumbers implements UnsafeValues {
         ApiVersion minimumVersion = MinecraftServer.getServer().server.minimumAPI;
 
         if (toCheck.isNewerThan(ApiVersion.CURRENT)) {
-            // Newer than supported
-            throw new InvalidPluginException("Unsupported API version " + descriptionFile.getAPIVersion());
+            // Purpurbedrock start - allow 26.x minor API plugins (e.g. WorldGuard 7.0.20 built against 26.3) on 26.2
+            if (org.purpurmc.purpur.PurpurConfig.bedrockAllowNewerMinorPluginApi && descriptionFile.getAPIVersion() != null && descriptionFile.getAPIVersion().startsWith("26.")) {
+                Bukkit.getLogger().info("[Purpurbedrock] Плагин " + descriptionFile.getFullName() + " (api-version " + descriptionFile.getAPIVersion() + ") загружен в режиме совместимости с 26.2.");
+            } else {
+                // Newer than supported
+                throw new InvalidPluginException("Unsupported API version " + descriptionFile.getAPIVersion());
+            }
+            // Purpurbedrock end
         }
 
         if (toCheck.isOlderThan(minimumVersion)) {
@@ -434,6 +440,11 @@ public final class CraftMagicNumbers implements UnsafeValues {
         final ApiVersion toCheck = ApiVersion.getOrCreateVersion(apiVersion);
         final ApiVersion minimumVersion = MinecraftServer.getServer().server.minimumAPI;
 
+        // Purpurbedrock start - allow 26.x minor API plugins on 26.2
+        if (toCheck.isNewerThan(ApiVersion.CURRENT) && org.purpurmc.purpur.PurpurConfig.bedrockAllowNewerMinorPluginApi && apiVersion.startsWith("26.")) {
+            return !toCheck.isOlderThan(minimumVersion);
+        }
+        // Purpurbedrock end
         return !toCheck.isNewerThan(ApiVersion.CURRENT) && !toCheck.isOlderThan(minimumVersion);
     }
 
